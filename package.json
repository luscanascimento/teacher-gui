{
  "name": "teacher-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "cp index.template.html index.html 2>/dev/null || true",
    "dev": "vite",
    "prebuild": "cp index.template.html index.html 2>/dev/null || true",
    "build": "tsc && vite build && cp dist/index.html ./index.html && cp -r dist/assets . && cp dist/index.html ./404.html && cp public/.nojekyll . 2>/dev/null || true && mkdir -p docs && cp -r dist/* docs/ && cp public/.nojekyll docs/ 2>/dev/null || true",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
